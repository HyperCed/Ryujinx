<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lowers dumped programs and runs them through the shader translator: dotnet run -c Release -- <dumps> [name filter] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Ryujinx.Graphics.Gpu/Ryujinx.Graphics.Gpu.csproj" />
  </ItemGroup>
</Project>
